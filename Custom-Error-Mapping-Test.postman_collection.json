        {
          "name": "Token expired (401) -> key _401 [TWO-VALUE: EXPIRED_TOKEN]",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/token-expired", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "token-expired"] },
            "description": "RF-TokenExpired -> _401. TWO-value substitution: errorvalue1=EXPIRED_TOKEN, errorvalue2='The provided token is expired'. Same key/structure as InvalidApiKey but different values."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode = EXPIRED_TOKEN', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('EXPIRED_TOKEN'); });",
            "pm.test('Message substituted', function () { pm.expect(pm.response.json().Errors[0].Message).to.eql('The provided token is expired'); });",
            "pm.test('No leftover placeholders', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "Forbidden scope (403) -> key _403 [ONE-VALUE: INSUFFICIENT_SCOPE]",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/forbidden-scope", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "forbidden-scope"] },
            "description": "RF-Forbidden -> _403. SINGLE-value substitution: errorvalue1=INSUFFICIENT_SCOPE. Message stays static."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
            "pm.test('Key _403', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_403'); });",
            "pm.test('ErrorCode = INSUFFICIENT_SCOPE', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INSUFFICIENT_SCOPE'); });",
            "pm.test('Message static', function () { pm.expect(pm.response.json().Errors[0].Message).to.eql('Client does not have required permissions'); });",
            "pm.test('No leftover placeholders', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "Forbidden IP (403) -> key _403 [ONE-VALUE: IP_BLOCKED]",
