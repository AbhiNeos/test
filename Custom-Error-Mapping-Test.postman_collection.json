{
  "info": {
    "name": "Custom Error Mapping - Platform & Backend",
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-345678901234",
    "description": "Tests KVM-based custom error mapping for Apigee platform errors and backend errors (mock backend via httpbin).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://your-apigee-org-env.apigee.net", "type": "string" },
    { "key": "basePath", "value": "/error-test", "type": "string" }
  ],
  "item": [
    {
      "name": "Platform Errors",
      "item": [
        {
          "name": "InvalidApiKey (401) -> key _401 [SUBSTITUTED: INVALID_TOKEN]",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}{{basePath}}/apikey?apikey=invalid-key-123",
              "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "apikey"],
              "query": [{ "key": "apikey", "value": "invalid-key-123" }]
            },
            "description": "InvalidApiKey -> key _401 with custom.error.value substitution. KVM entry has placeholders errorvalue1/errorvalue2; SF-ErrorHandling replaces them with INVALID_TOKEN / 'The provided token is missing or invalid'."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode substituted to INVALID_TOKEN', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_TOKEN'); });",
            "pm.test('Message substituted', function () { pm.expect(pm.response.json().Errors[0].Message).to.eql('The provided token is missing or invalid'); });",
            "pm.test('No leftover placeholders', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "NoJWKS (401) -> key _JWKS",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/jwks", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "jwks"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _JWKS', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_JWKS'); });"
          ] } }]
        },
        {
          "name": "JWS failure (401) -> key _JWS",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/jws", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "jws"] }
          },
