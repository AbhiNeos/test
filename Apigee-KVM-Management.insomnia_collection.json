      "name": "Delete Proxy Config Entry",
      "method": "DELETE",
      "url": "https://apigee.googleapis.com/v1/organizations/{{ _.org }}/environments/{{ _.env }}/keyvaluemaps/{{ _.kvm_name }}/entries/{{ _.proxy_name }}",
