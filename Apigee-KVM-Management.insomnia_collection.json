      "name": "Apigee KVM Management",
      "description": "Collection to manage Apigee X KVMs via Management API.\n\nGet token: gcloud auth print-access-token\nPaste it into the 'token' environment variable.\n\nFor Add/Update entry: edit the JSON in the request body, then use the helper request 'Stringify JSON Config' to convert it.",
      "scope": "collection"
    },
    {
      "_id": "env_apigee_kvm",
      "_type": "environment",
      "parentId": "wrk_apigee_kvm",
      "name": "Apigee Environment",
      "data": {
        "org": "YOUR_ORG_NAME",
        "env": "YOUR_ENV_NAME",
        "kvm_name": "PreFlightCheck",
        "proxy_name": "dummy-proxy",
        "token": "PASTE_GCLOUD_AUTH_TOKEN_HERE"
      },
      "dataPropertyOrder": {
        "&": ["org", "env", "kvm_name", "proxy_name", "token"]
      }
    },
    {
