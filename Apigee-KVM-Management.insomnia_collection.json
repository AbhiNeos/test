      "name": "KVM Operations"
    },
    {
      "_id": "req_create_kvm",
      "_type": "request",
      "parentId": "fld_kvm",
      "name": "Create KVM",
      "method": "POST",
      "url": "https://apigee.googleapis.com/v1/organizations/{{ _.org }}/environments/{{ _.env }}/keyvaluemaps",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ _.token }}" },
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"{{ _.kvm_name }}\",\n  \"encrypted\": true\n}"
      }
    },
    {
      "_id": "req_list_kvms",
      "_type": "request",
      "parentId": "fld_kvm",
      "name": "List KVMs",
