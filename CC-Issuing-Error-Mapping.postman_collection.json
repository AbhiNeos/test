{
  "info": {
    "name": "CC Issuing - Custom Error Mapping (AMZ_ARW)",
    "_postman_id": "d4e5f6a7-b8c9-0123-def4-456789012345",
    "description": "Tests KVM-based custom error mapping for the Credit Card Issuing Quote and Application Management proxy (cc-issuing-quote-app-mgmt, prefix AMZ_ARW).\n\nPlatform: 403 by status; 401 single-value substitution (InvalidExpiredToken / MissingCredentials / OauthIssue); OAS -> 400; quota -> 429; fallback -> 500.\nBackend: 401->500, 500->500, 403->403, fallback BE_500.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://your-apigee-org-env.apigee.net", "type": "string" },
    { "key": "basePath", "value": "/cc-issuing", "type": "string" }
  ],
  "item": [
    {
      "name": "Platform Errors",
      "item": [
        {
          "name": "403 Forbidden -> key _403",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/forbidden", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "forbidden"] },
            "description": "403 mapped purely by status code -> AMZ_ARW_cc-issuing-quote-app-mgmt_403. No substitution."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
            "pm.test('Key _403', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_403'); });",
            "pm.test('ErrorCode FORBIDDEN', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('FORBIDDEN'); });"
          ] } }]
        },
        {
          "name": "401 (a) Invalid/Expired Token -> _401 + InvalidExpiredToken",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/token-invalid", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "token-invalid"] },
            "description": "Shared key _401; errorvalue1 substituted with InvalidExpiredToken."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode = InvalidExpiredToken', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('InvalidExpiredToken'); });",
            "pm.test('No leftover placeholder', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "401 (b) Missing Credentials -> _401 + MissingCredentials",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/token-missing", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "token-missing"] },
            "description": "Same key _401; errorvalue1 substituted with MissingCredentials."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode = MissingCredentials', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('MissingCredentials'); });",
            "pm.test('No leftover placeholder', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "401 (c) Other OAuth Issue -> _401 + OauthIssue",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/oauth-other", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "oauth-other"] },
            "description": "Same key _401; errorvalue1 substituted with OauthIssue (catch-all 401)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode = OauthIssue', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('OauthIssue'); });",
            "pm.test('No leftover placeholder', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "401 via VerifyAPIKey failure -> _401 + OauthIssue",
          "request": {
            "method": "GET", "header": [],
            "url": {
              "raw": "{{baseUrl}}{{basePath}}/apikey?apikey=invalid-key-123",
              "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "apikey"],
              "query": [{ "key": "apikey", "value": "invalid-key-123" }]
            },
            "description": "Real InvalidApiKey fault -> _401 with OauthIssue bucket."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode substituted', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.be.oneOf(['OauthIssue','MissingCredentials']); });",
            "pm.test('No leftover placeholder', function () { pm.expect(pm.response.text()).to.not.include('errorvalue'); });"
          ] } }]
        },
        {
          "name": "OAS invalid path -> key _400",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/oas-badpath", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "oas-badpath"] },
            "description": "Path not in the OpenAPI spec. All OAS failures map to _400 (status 400)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400'); });",
            "pm.test('ErrorCode INVALID_INPUT', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_INPUT'); });"
          ] } }]
        },
        {
          "name": "OAS schema violation on /quotes -> key _400",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"requestedLimit\": \"not-a-number\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}{{basePath}}/quotes", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "quotes"] },
            "description": "Missing required applicantId and wrong type for requestedLimit -> OAS failure -> _400."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400'); });"
          ] } }]
        },
        {
          "name": "Quota - 1st call (passes)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Client-Id", "value": "cc-quota-test" }],
            "url": { "raw": "{{baseUrl}}{{basePath}}/rate-limited", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "rate-limited"] },
            "description": "First call within the 1/min quota window."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('First call not rate limited', function () { pm.expect(pm.response.code).to.not.eql(429); });"
          ] } }]
        },
        {
          "name": "Quota - 2nd call -> key _429",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Client-Id", "value": "cc-quota-test" }],
            "url": { "raw": "{{baseUrl}}{{basePath}}/rate-limited", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "rate-limited"] },
            "description": "Second call with the same X-Client-Id -> QuotaViolation -> _429 (status 429)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 429', function () { pm.response.to.have.status(429); });",
            "pm.test('Key _429', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_429'); });",
            "pm.test('ErrorCode QUOTA_EXCEEDED', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('QUOTA_EXCEEDED'); });"
          ] } }]
        },
        {
          "name": "Unmapped fault -> key _500 (platform fallback)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/unmapped", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "unmapped"] },
            "description": "Fault not matched by any rule -> platform fallback key _500."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
            "pm.test('Key _500', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_500'); });",
            "pm.test('ErrorCode INTERNAL_ERROR', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INTERNAL_ERROR'); });"
          ] } }]
        }
      ]
    },
    {
      "name": "status Errors",
      "item": [
        {
          "name": "status 401 -> key _BE_401_500 (status 500)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/status/401", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "status", "401"] },
            "description": "status returns 401 -> remapped to 500 with key _BE_401_500."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
            "pm.test('Key _BE_401_500', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_BE_401_500'); });",
            "pm.test('ErrorCode BACKEND_AUTH_ERROR', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('BACKEND_AUTH_ERROR'); });"
          ] } }]
        },
        {
          "name": "status 500 -> key _BE_500_500 (status 500)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/status/500", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "status", "500"] },
            "description": "status returns 500 -> key _BE_500_500 (status 500)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
            "pm.test('Key _BE_500_500', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_BE_500_500'); });",
            "pm.test('ErrorCode BACKEND_INTERNAL_ERROR', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('BACKEND_INTERNAL_ERROR'); });"
          ] } }]
        },
        {
          "name": "status 403 -> key _BE_403_403 (status 403)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/status/403", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "status", "403"] },
            "description": "status returns 403 -> preserved as 403 with key _BE_403_403."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
            "pm.test('Key _BE_403_403', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_BE_403_403'); });",
            "pm.test('ErrorCode BACKEND_FORBIDDEN', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('BACKEND_FORBIDDEN'); });"
          ] } }]
        },
        {
          "name": "status 418 (unmapped) -> key _BE_500 (status 500)",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/status/418", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "status", "418"] },
            "description": "status status not in the mapping table -> fixed status fallback key _BE_500 (status 500)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
            "pm.test('Key _BE_500', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_BE_500'); });",
            "pm.test('ErrorCode BACKEND_ERROR', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('BACKEND_ERROR'); });"
          ] } }]
        }
      ]
    }
  ]
}
