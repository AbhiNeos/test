            "pm.test('ErrorCode UNSUPPORTED_MEDIA_TYPE', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('UNSUPPORTED_MEDIA_TYPE'); });"
          ] } }]
        },
        {
          "name": "OAS: field regex fails (sortCode) -> _400_InvalidFieldFormat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-fapi-financial-id", "value": "{{validFapiId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"paymentId\": \"PAY-001\",\n  \"amount\": 100.50,\n  \"sortCode\": \"ABCDEF\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}{{basePath}}/payments", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "payments"] },
            "description": "All required fields present, but sortCode fails pattern ^[0-9]{6}$ -> _400_InvalidFieldFormat."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400_InvalidFieldFormat', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400_InvalidFieldFormat'); });",
            "pm.test('ErrorCode INVALID_FIELD_FORMAT', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_FIELD_FORMAT'); });"
          ] } }]
        },
        {
          "name": "OAS: payload validation -> _400_InvalidPayload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-fapi-financial-id", "value": "{{validFapiId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reference\": \"no-required-fields\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}{{basePath}}/payments", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "payments"] },
            "description": "Required properties paymentId/amount/sortCode missing -> _400_InvalidPayload."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400_InvalidPayload', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400_InvalidPayload'); });",
            "pm.test('ErrorCode INVALID_PAYLOAD', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_PAYLOAD'); });"
          ] } }]
        }
      ]
