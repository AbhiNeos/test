{
  "info": {
    "name": "COP API Testing - Custom Error Mapping (COP)",
    "_postman_id": "e5f6a7b8-c9d0-1234-ef56-567890123456",
    "description": "Tests KVM-based custom error mapping for proxy cop_api_testing (prefix COP).\n\nPlatform: all 401 -> _401; all 403 -> _403; JOSE faults -> 5 distinct 400 keys; OAS string-matched into 400_MissingFapiId / 400_InvalidFapiId / 400_InvalidFieldFormat / 400_InvalidPayload plus exceptions 406_InvalidAccept / 406_InvalidHeader / 415 / 404 / 500; fallback -> _500.\nBackend: 401,404,405,406,412,415,500,502 -> 500 via _BE_<code>_500; fallback _BE_500.\n\nNo placeholder substitution - every key returns a complete body verbatim.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://your-apigee-org-env.apigee.net", "type": "string" },
    { "key": "basePath", "value": "/cop-api", "type": "string" },
    { "key": "validFapiId", "value": "ABC-123456", "type": "string" },
    { "key": "validRequestId", "value": "req-12345678", "type": "string" }
  ],
  "item": [
    {
      "name": "Platform - Simple Buckets",
      "item": [
        {
          "name": "401 any -> key _401",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/unauthorized", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "unauthorized"] },
            "description": "All 401 scenarios collapse to the single key _401."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 401', function () { pm.response.to.have.status(401); });",
            "pm.test('Key _401', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_401'); });",
            "pm.test('ErrorCode UNAUTHORIZED', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('UNAUTHORIZED'); });"
          ] } }]
        },
        {
          "name": "403 any -> key _403",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/forbidden", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "forbidden"] },
            "description": "All 403 scenarios collapse to the single key _403."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 403', function () { pm.response.to.have.status(403); });",
            "pm.test('Key _403', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_403'); });",
            "pm.test('ErrorCode FORBIDDEN', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('FORBIDDEN'); });"
          ] } }]
        },
        {
          "name": "Unmapped -> fallback key _500",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}{{basePath}}/unmapped", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "unmapped"] },
            "description": "Fault matching no rule -> default fallback key _500."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 500', function () { pm.response.to.have.status(500); });",
            "pm.test('Key _500', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_500'); });",
            "pm.test('ErrorCode INTERNAL_ERROR', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INTERNAL_ERROR'); });"
          ] } }]
        }
      ]
    },
