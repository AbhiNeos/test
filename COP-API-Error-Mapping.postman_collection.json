    {
      "name": "Platform - OAS Validation",
      "item": [
        {
          "name": "OAS: x-fapi-financial-id MISSING -> _400_MissingFapiId",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-request-id", "value": "{{validRequestId}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{basePath}}/accounts", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "accounts"] },
            "description": "Required header x-fapi-financial-id omitted -> OAS 'is required' -> _400_MissingFapiId."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400_MissingFapiId', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400_MissingFapiId'); });",
            "pm.test('ErrorCode MISSING_FINANCIAL_ID', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('MISSING_FINANCIAL_ID'); });"
          ] } }]
        },
        {
          "name": "OAS: x-fapi-financial-id BAD REGEX -> _400_InvalidFapiId",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-fapi-financial-id", "value": "NOT-VALID-FORMAT" },
              { "key": "x-request-id", "value": "{{validRequestId}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{basePath}}/accounts", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "accounts"] },
            "description": "Header present but fails pattern ^[A-Z]{3}-[0-9]{6}$ -> _400_InvalidFapiId."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
            "pm.test('Key _400_InvalidFapiId', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_400_InvalidFapiId'); });",
            "pm.test('ErrorCode INVALID_FINANCIAL_ID', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_FINANCIAL_ID'); });"
          ] } }]
        },
        {
          "name": "OAS: bad Accept header -> _406_InvalidAccept",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-fapi-financial-id", "value": "{{validFapiId}}" },
              { "key": "x-request-id", "value": "{{validRequestId}}" },
              { "key": "Accept", "value": "application/xml" }
            ],
            "url": { "raw": "{{baseUrl}}{{basePath}}/accounts", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "accounts"] },
            "description": "Accept is not application/json -> _406_InvalidAccept (checked before media-type)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 406', function () { pm.response.to.have.status(406); });",
            "pm.test('Key _406_InvalidAccept', function () { pm.expect(pm.response.headers.get('X-Error-Key')).to.include('_406_InvalidAccept'); });",
            "pm.test('ErrorCode INVALID_ACCEPT_HEADER', function () { pm.expect(pm.response.json().Errors[0].ErrorCode).to.eql('INVALID_ACCEPT_HEADER'); });"
          ] } }]
        },
        {
          "name": "OAS: other invalid header -> _406_InvalidHeader",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-fapi-financial-id", "value": "{{validFapiId}}" },
              { "key": "x-request-id", "value": "bad!" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}{{basePath}}/accounts", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "accounts"] },
            "description": "x-request-id fails its pattern (and is not the fapi header / Accept) -> _406_InvalidHeader."
