          ] } }]
        },
        {
          "name": "OAS: method not allowed (DELETE) -> _404",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-fapi-financial-id", "value": "{{validFapiId}}" },
              { "key": "x-request-id", "value": "{{validRequestId}}" }
            ],
            "url": { "raw": "{{baseUrl}}{{basePath}}/accounts", "host": ["{{baseUrl}}"], "path": ["{{basePath}}", "accounts"] },
